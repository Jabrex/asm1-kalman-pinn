# Environments and caches
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / agent state
.claude/
.obsidian/
.vscode/
.idea/
docs/superpowers/

# Manuscript and journal submission (not part of the code + data archive)
paper/
submission/

# Internal planning and publishing notes inside the Obsidian vault
asm1_cl-pinn/Publishing/
asm1_cl-pinn/Seed Variance Plan.md

# Turkish-language working notes (the public runbook is RUNBOOK.en.md)
RUNBOOK.md
CALISTIRMA_SIRASI.txt

# One-off diagnostics that are not part of the pipeline
scripts_diag/
diagnostic_all.py
test_diag.py

# LaTeX and OS by-products
*.aux
*.log
*.out
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
Thumbs.db
.DS_Store

# v1.1 smoke and probe runs (underscore prefix; collect_runs skips them too)
results/v11/_*/

# v1.1 truth-plant datasets (G2). Regenerated bit for bit by scripts/generate_data.py
# (the exact argv is in each manifest.json) with OPENBLAS_NUM_THREADS=4; SHA-256 of
# every file in results/v11/data_checksums.json. The manifests stay tracked.
results/raw_k*/*.npz
results/raw_rand/*/*.npz
results/raw/obs_dry_sigma0p10_r*.npz

# v1.1 bulk outputs. Observer and baseline predictions (about 1 GB in total)
# go into the Zenodo v1.1 archive, not into git; their summary.json files are
# tracked. Smoke and contract runs keep only their reports.
results/v11/observers/**/predictions.npz
results/v11/baselines/**/predictions.npz
results/v11/_numerics/**/predictions.npz
results/v11/_contract/
results/v11/_smoke/*/
results/v11/_smoke_g1/
results/v11/run_core_inflight.json

# Generated datasets, training runs, estimator outputs, figures and tables.
# They are archived on Zenodo (see README) and are not tracked here; only the
# pre-registration probe scripts and their short text outputs stay.
results/*
!results/v11/
results/v11/*
!results/v11/predating/
results/v11/predating/*
!results/v11/predating/*.py
!results/v11/predating/*.json
!results/v11/predating/*.txt

# Images and binary model or data files anywhere in the tree
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf
*.npz
*.pt
